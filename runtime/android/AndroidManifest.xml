<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pes6port" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- WIRELESS mode: UDP between devices on the local network (runtime/common/net.c) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- WifiLock during WIRELESS play: no radio power saving, no stutters (docs/15 §9) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wi-Fi Direct between the phones (docs/15 §11, java/com/pes6port/WifiDirect.java) -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- the touch controls' tick when sprinting starts or a flick adds L/R (java/com/pes6port/Device.java) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Not debuggable: a debuggable app runs the framework's Java interpreted, and the touch input
         path alone cost ~14% of a core on the Redmi (docs/32 §8). profileable keeps simpleperf. -->
    <application android:label="PES6" android:icon="@mipmap/ic_launcher" android:hasCode="true" android:debuggable="false">
        <profileable android:shell="true" />
        <activity android:name="android.app.NativeActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/PES6Theme"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation">
            <meta-data android:name="android.app.lib_name" android:value="pes6" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the system's file picker for the player's ISO (java/com/pes6port/IsoPicker.java, docs/35) -->
        <activity android:name="com.pes6port.IsoPicker" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation" />
    </application>
</manifest>
