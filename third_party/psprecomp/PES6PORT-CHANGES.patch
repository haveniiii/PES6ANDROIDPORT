+/* PSP_HLE_TRACE=<substr>[,<substr>...] logs every firmware call whose name
+ * contains one of the substrings ("sceIo", "Sema", or "*" for all): arguments
+ * on entry, result on return (two lines, because a blocking call returns many
+ * other calls later). PSP_HLE_TRACE_MAX caps the lines (default 4000). */
+static const char *g_trace_filter;
+static long g_trace_left = -1;
+
+static int trace_match(const char *name) {
+    if (g_trace_left < 0) {
+        const char *m = getenv("PSP_HLE_TRACE_MAX");
+        g_trace_filter = getenv("PSP_HLE_TRACE");
+        g_trace_left = m && *m ? atol(m) : 4000;
+    }
+    if (!g_trace_filter || !*g_trace_filter || g_trace_left <= 0 || !name) return 0;
+    for (const char *p = g_trace_filter; *p; ) {
+        const char *e = strchr(p, ',');
+        size_t n = e ? (size_t)(e - p) : strlen(p);
+        if (n == 1 && *p == '*') return 1;
+        if (n && n < 64) {
+            char pat[64];
+            memcpy(pat, p, n); pat[n] = 0;
+            if (strstr(name, pat)) return 1;
+        }
+        p = e ? e + 1 : p + n;
+    }
+    return 0;
+}
