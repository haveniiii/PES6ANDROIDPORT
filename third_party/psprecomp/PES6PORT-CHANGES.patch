+        for (int i = 0; i < MAX_THREADS; i++) {
+            if (!g_thread[i].used || g_thread[i].state == TH_DORMANT) continue;
+            alive = 1;
+            if (g_thread[i].state == TH_BLOCKED) blocked = 1;
+        }
