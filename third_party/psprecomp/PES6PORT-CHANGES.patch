+/* Float to 32-bit integer the way the FPU does it: mode 0 nearest (ties to
+ * even), 1 toward zero, 2 up, 3 down; out of range and NaN saturate. */
+static inline uint32_t psp_f2i(float f, int mode) {
+    double v = (double)f;
+    if (v != v) return 0x7FFFFFFFu;
+    switch (mode) {
+    case 0:  v = __builtin_rint(v);  break;
+    case 1:  v = __builtin_trunc(v); break;
+    case 2:  v = __builtin_ceil(v);  break;
+    default: v = __builtin_floor(v); break;
+    }
+    if (v >= 2147483647.0) return 0x7FFFFFFFu;
+    if (v <= -2147483648.0) return 0x80000000u;
+    return (uint32_t)(int32_t)v;
+}
+
